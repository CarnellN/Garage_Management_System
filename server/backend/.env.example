# Copy this file to .env inside backend/. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# MySQL 8.0.16+ is the default. URL-encode the database password.
DB_CLIENT=mysql
DATABASE_URL=mysql://garage_user:ENCODED_PASSWORD@localhost:3306/garage_management_db
# Supabase/PostgreSQL backup option: replace DB_CLIENT and DATABASE_URL:
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Copy the actual URI from Supabase -> Connect -> Session pooler.
# For Supabase or hosted MySQL, set DB_SSL=true.
DB_POOL_MAX=5
# Local MySQL without TLS only (development/test and localhost).
DB_SSL=false
# Optional database CA certificate for either provider, relative to backend/.
# Download from your project's database connection settings if required.
# Leave blank to use the system CA trust store; certificate verification stays on.
DB_SSL_CA_FILE=
