# Copy this file to .env.local inside backend/server/. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Generate a random signing secret locally (see README). Never share or commit it.
# Auth routes return 503 until JWT_SECRET has at least 32 bytes; required in production.
JWT_SECRET=
JWT_ISSUER=garage-management-api
JWT_AUDIENCE=garage-frontend
JWT_TTL_SECONDS=900

# Garage local hours in Africa/Nairobi; weekdays use 0=Sunday, 6=Saturday.
# Confirm these operational settings and labor rate with the garage.
GARAGE_OPEN_TIME=08:00
GARAGE_CLOSE_TIME=17:00
GARAGE_OPEN_DAYS=1,2,3,4,5,6
LABOR_HOURLY_RATE=1000.00

# MySQL 8.0.16+ is the supported database. Use either connection fields or DATABASE_URL.
DB_CLIENT=mysql
# DATABASE_URL=mysql://garage_user:ENCODED_PASSWORD@localhost:3306/garage_management_db
# Alternatively, use Aiven's connection fields:
DB_HOST=mysql.example.aivencloud.com
DB_USER=garage_user
DB_PASSWORD=replace-me
DB_NAME=garage_management_db
DB_PORT=12345
# DB_CA="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
# For hosted MySQL, set DB_SSL=true and provide DB_CA or DB_SSL_CA_FILE if required.
DB_POOL_MAX=5
# Local MySQL without TLS only (development/test and localhost).
DB_SSL=false
# Optional database CA certificate file, relative to backend/.
# Leave blank to use the system CA trust store; certificate verification stays on.
DB_SSL_CA_FILE=

# ---- Garage details printed on reports and invoices ----
GARAGE_NAME=Garage Management System
GARAGE_ADDRESS=Nairobi, Kenya
GARAGE_PHONE=+254 700 000 000
GARAGE_EMAIL=info@garage.local
# Optional PNG/JPEG logo; a drawn logo with the garage initials is used when blank.
GARAGE_LOGO_FILE=

# Frontend address used in password reset links (defaults to the first CORS origin).
APP_BASE_URL=http://localhost:5173

# Key for encrypting two-factor secrets at rest: 32 random bytes, base64url. Generate with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# If blank, a key is derived from JWT_SECRET (rotating JWT_SECRET then resets everyone's 2FA).
DATA_ENCRYPTION_KEY=

# ---- Email (password reset). Without SMTP, development servers print reset emails to the log. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Garage Management System <no-reply@garage.local>

# ---- M-Pesa Daraja STK push. Set all six to enable online checkout. ----
# Sandbox test values are on https://developer.safaricom.co.ke (shortcode 174379 + its passkey).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public https address of this API (e.g. an ngrok URL in development). Safaricom cannot reach localhost.
MPESA_CALLBACK_BASE_URL=
# At least 32 random URL-safe characters; becomes a secret part of the callback URL.
MPESA_CALLBACK_TOKEN=
# CustomerPayBillOnline (default) or CustomerBuyGoodsOnline for till numbers.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
