# Copy this file to .env.local inside backend/server/. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Generate a random signing secret locally (see README). Never share or commit it.
# Auth routes return 503 until JWT_SECRET has at least 32 bytes; required in production.
JWT_SECRET=
JWT_ISSUER=garage-management-api
JWT_AUDIENCE=garage-frontend
JWT_TTL_SECONDS=900

# Garage local hours in Africa/Nairobi; weekdays use 0=Sunday, 6=Saturday.
# Confirm these operational settings and labor rate with the garage.
GARAGE_OPEN_TIME=08:00
GARAGE_CLOSE_TIME=17:00
GARAGE_OPEN_DAYS=1,2,3,4,5,6
LABOR_HOURLY_RATE=1000.00

# MySQL 8.0.16+ is the supported database. Use either connection fields or DATABASE_URL.
DB_CLIENT=mysql
# DATABASE_URL=mysql://garage_user:ENCODED_PASSWORD@localhost:3306/garage_management_db
# Alternatively, use Aiven's connection fields:
DB_HOST=mysql.example.aivencloud.com
DB_USER=garage_user
DB_PASSWORD=replace-me
DB_NAME=garage_management_db
DB_PORT=12345
# DB_CA="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
# For hosted MySQL, set DB_SSL=true and provide DB_CA or DB_SSL_CA_FILE if required.
DB_POOL_MAX=5
# Local MySQL without TLS only (development/test and localhost).
DB_SSL=false
# Optional database CA certificate file, relative to backend/.
# Leave blank to use the system CA trust store; certificate verification stays on.
DB_SSL_CA_FILE=
