{
  "name": "garage-management-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Garage Management System with PostgreSQL and MySQL adapters",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:mysql": "node --test integration/mysql.test.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "client:generate": "node scripts/generate-client.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "mysql2": "^3.24.6",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
