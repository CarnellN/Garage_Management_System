{
  "name": "garage-management-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Garage Management System with PostgreSQL and MySQL adapters",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.6",
    "pg": "^8.16.3"
  }
}
