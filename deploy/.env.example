# Copy to deploy/.env for docker compose. Never commit the filled-in file.
NODE_ENV=production
# Database passwords for the bundled MySQL container.
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
# true loads the demo customers/staff/jobs into an empty database (demo password: Password123!).
SEED_DEMO=false

GARAGE_NAME=Garage Management System
GARAGE_ADDRESS=Nairobi, Kenya
GARAGE_PHONE=+254 700 000 000
GARAGE_EMAIL=info@garage.local
GARAGE_OPEN_TIME=08:00
GARAGE_CLOSE_TIME=17:00
GARAGE_OPEN_DAYS=1,2,3,4,5,6
LABOR_HOURLY_RATE=1000.00

# Optional: SMTP for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Garage Management System <no-reply@garage.local>

# Optional: M-Pesa Daraja STK push (all six required together). See docs/USER_MANUAL.md.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_TOKEN=
